NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.onproit.com

# Server-side only — used by the /admin dashboard to bypass RLS. Never expose
# this to the browser. Find it in Supabase: Project Settings > API > secret key
# (older projects call this the service_role key).
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (email) ──────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=gregg@onproit.com
CONTACT_FROM_EMAIL=ONPRO IT Website <site@onproit.com>

# ── Cloudflare Turnstile (bot protection on the contact form) ────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Search Console (top search queries in the admin dashboard) ─
# Service account added as a Restricted user on the property in Search
# Console. GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY is the "private_key" field
# from the downloaded JSON key, pasted as-is (including the \n sequences).
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:onproit.com

# ── Cron auth ─────────────────────────────────────────────────────────
# Vercel automatically sends this as a Bearer token when it invokes a
# scheduled cron route (see vercel.json), so /api/cron/* routes can verify
# the request actually came from Vercel's scheduler and not a random caller.
CRON_SECRET=
