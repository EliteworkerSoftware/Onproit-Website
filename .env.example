NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.onproit.com

# Server-side only — used by the /admin dashboard to bypass RLS. Never expose
# this to the browser. Find it in Supabase: Project Settings > API > secret key
# (older projects call this the service_role key).
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (email) ──────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=gregg@onproit.com
CONTACT_FROM_EMAIL=ONPRO IT Website <site@onproit.com>

# ── Cloudflare Turnstile (bot protection on the contact form) ────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Search Console (top search queries in admin dashboard, sitemap resubmission) ─
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY is the "private_key" field from the
# downloaded JSON key, pasted as-is (including the \n sequences). The service
# account must be added as a FULL user on the property in Search Console
# (Settings > Users and permissions) — a Restricted user can read analytics
# and sitemap status but gets a 403 on submitSitemap().
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:onproit.com

# ── Cron auth ─────────────────────────────────────────────────────────
# Vercel automatically sends this as a Bearer token when it invokes a
# scheduled cron route (see vercel.json), so /api/cron/* routes can verify
# the request actually came from Vercel's scheduler and not a random caller.
CRON_SECRET=

# ── IndexNow (instant crawl ping to Bing/Yandex — Google doesn't support
# this protocol) — any 32+ char hex string works, it's just a shared secret
# that proves you own the site via the key file route it's paired with.
INDEXNOW_KEY=

# ── Content agent (the scheduled "onproit-content-agent" routine) — shared
# secret for the narrow /api/cron/queued-keywords, /api/cron/keywords/[id]
# and /api/cron/suggested-keywords endpoints.
CONTENT_AGENT_SECRET=

# ── DataForSEO (Google Ads search volume for tracked keywords) — login and
# API password from app.dataforseo.com/api-access. Optional: without them the
# daily sync just skips the volume lookup. Billed per request (~$0.075, up to
# 1,000 keywords each); the sync makes at most one a day and stops for the
# month once spend would pass the budget below (defaults to $3).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MONTHLY_BUDGET_USD=3
